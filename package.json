{
  "name": "senkei",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "version": "0.1.1",
  "description": "Unity-like gamedev math for JavaScript and TypeScript",
  "type": "module",
  "keywords": [
    "math",
    "gamedev"
  ],
  "author": "Marco Kammer",
  "homepage": "https://github.com/kamm3r/math",
  "repository": "https://github.com/kamm3r/math",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest",
    "build": "tsup src/index.ts --format cjs,esm --dts --minify",
    "release": "pnpm run build && changeset publish",
    "lint": "tsc",
    "benchmark": "pnpm run build && node bench/perf.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "22.20.3",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
